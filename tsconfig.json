{
    "compilerOptions": {
        "outDir": "dist",
        "module": "CommonJS",
        "target": "ES2022",
        "esModuleInterop": true,
        "sourceMap": true,
        "rootDirs": ["src", "tests"],
        "baseUrl": "src",
        "paths": {
            "@/*": ["*"]
        },

    },
    "include": [
        "src"
    ],
    "exclude": [
        "tests"
    ]
}
